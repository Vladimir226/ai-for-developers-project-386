{
  "name": "book-a-call",
  "version": "0.1.0",
  "private": true,
  "description": "«Запись на звонок» (Book-a-Call) — сервис бронирования звонков",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "check": "npm run lint && npm run format:check && npm test",
    "contract:compile": "cd contract && tsp compile .",
    "contract:gen": "npm run contract:compile && openapi-typescript src/generated/openapi.yaml -o src/generated/schema.d.ts && openapi-zod-client src/generated/openapi.yaml -o src/generated/zod.ts --export-schemas -t node_modules/openapi-zod-client/src/templates/schemas-only.hbs",
    "contract:drift-check": "bash scripts/contract-drift-check.sh",
    "lint": "eslint . && tsc --noEmit && redocly lint src/generated/openapi.yaml && npm run contract:drift-check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.0",
    "openapi-fetch": "^0.17.0",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.65.0",
    "@redocly/cli": "^2.76.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.5",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
