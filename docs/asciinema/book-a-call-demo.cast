{"version":3,"term":{"cols":80,"rows":24},"timestamp":1794076333,"command":"zsh /tmp/t10-demo.sh","env":{"SHELL":"/bin/zsh"}}
[0.011, "o", "── Запущенный контейнер ─────────────────────────────────────────────\r\n"]
[0.016, "o", "NAMES         STATUS                    PORTS\r\nbook-a-call   Up 13 seconds (healthy)   0.0.0.0:3000->3000/tcp, [::]:3000->3000/tcp\r\n"]
[2.013, "o", "\r\n"]
[0.000, "o", "── 1. Здоровье сервиса ──────────────────────────────────────────────\r\n"]
[0.029, "o", "{\"status\":\"ok\"}"]
[0.001, "o", "\r\n"]
[2.014, "o", "\r\n"]
[0.000, "o", "── 2. Владелец публикует интервал (завтра 18:00–18:30 UTC) ──────────\r\n"]
[0.012, "o", "POST /api/v1/slots  {\"startsAt\":\"2026-11-08T18:00:00Z\",\"endsAt\":\"2026-11-08T18:30:00Z\"}\r\n"]
[0.046, "o", "{\"id\":\"eb8ce22d-8787-49db-a6ba-9ec0f1ca0c67\",\"startsAt\":\"2026-11-08T18:00:00.000Z\",\"endsAt\":\"2026-11-08T18:30:00.000Z\"}"]
[0.001, "o", "\r\n"]
[2.092, "o", "\r\n── 3. Посетитель видит только свободные будущие слоты ───────────────\r\n"]
[0.011, "o", "{\"slots\":[{\"id\":\"eb8ce22d-8787-49db-a6ba-9ec0f1ca0c67\",\"startsAt\":\"2026-11-08T18:00:00.000Z\",\"endsAt\":\"2026-11-08T18:30:00.000Z\"}]}"]
[0.001, "o", "\r\n"]
[2.012, "o", "\r\n"]
[0.000, "o", "── 4. Посетитель бронирует слот ─────────────────────────────────────\r\n"]
[0.037, "o", "{\"id\":\"97f3ab15-7098-41bc-9e19-f3ab73cf50f1\",\"slotId\":\"eb8ce22d-8787-49db-a6ba-9ec0f1ca0c67\",\"startsAt\":\"2026-11-08T18:00:00.000Z\",\"endsAt\":\"2026-11-08T18:30:00.000Z\",\"bookerName\":\"Анна\",\"bookerContact\":\"@anna\",\"createdAt\":\"2026-11-07T18:32:22.298Z\",\"comment\":\"созвон по проекту\"}"]
[0.000, "o", "\r\n"]
[2.086, "o", "\r\n── 5. Второй посетитель бронирует тот же слот → 409 ─────────────────\r\n"]
[0.014, "o", "{\"error\":{\"code\":\"SLOT_ALREADY_BOOKED\",\"message\":\"Слот уже забронирован\"}}\r\nHTTP 409\r\n"]
[2.013, "o", "\r\n── 6. Владелец отменяет бронь → слот снова свободен ─────────────────\r\n"]
[0.000, "o", "DELETE /api/v1/bookings/97f3ab15-7098-41bc-9e19-f3ab73cf50f1\r\n"]
[0.030, "o", "HTTP 204\r\n"]
[1.045, "o", "{\"slots\":[{\"id\":\"eb8ce22d-8787-49db-a6ba-9ec0f1ca0c67\",\"startsAt\":\"2026-11-08T18:00:00.000Z\",\"endsAt\":\"2026-11-08T18:30:00.000Z\"}]}"]
[0.000, "o", "\r\n\r\n"]
[0.000, "o", "Слот вернулся в список свободных. Демо завершено.\r\n"]
[2.016, "x", "0"]
